# Production on Vercel uses the same-origin /api rewrite when empty.
# For local development, use http://localhost:4000/api or set a staging API URL.
VITE_API_BASE_URL=

# Google OAuth (login social)
# Client ID gerado no Google Cloud Console (OAuth 2.0 Client IDs, tipo "Web application").
# Deixe vazio para desabilitar o botão "Continuar com Google".
VITE_GOOGLE_CLIENT_ID=
